<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RevitToolkit</AssemblyName>
    <RootNamespace>RevitToolkit</RootNamespace>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <!-- Post-build: copy to Revit addins folder automatically -->
    <PostBuildEvent>
      xcopy /Y /I "$(TargetPath)" "$(AppData)\Autodesk\Revit\Addins\2024\"
      xcopy /Y /I "$(ProjectDir)RevitToolkit.addin" "$(AppData)\Autodesk\Revit\Addins\2024\"
    </PostBuildEvent>
  </PropertyGroup>

  <!-- Revit API references — adjust path for your Revit version -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- XAML pages -->
  <ItemGroup>
    <Page Include="UI\CopyDimensionsDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="UI\AutoKeynoteTagDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
