<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RevitToolkit</AssemblyName>
    <RootNamespace>RevitToolkit</RootNamespace>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <!-- Post-build: copy to Revit addins folder (skipped in CI) -->
    <PostBuildEvent Condition="'$(CI)' != 'true'">
      xcopy /Y /I "$(TargetPath)" "$(AppData)\Autodesk\Revit\Addins\2024\"
      xcopy /Y /I "$(ProjectDir)RevitToolkit.addin" "$(AppData)\Autodesk\Revit\Addins\2024\"
    </PostBuildEvent>
  </PropertyGroup>

  <!-- Revit API references — NuGet stubs for CI; HintPath used if DLLs exist locally -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.*"/>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.*"/>
  </ItemGroup>

  <!-- XAML pages -->
  <ItemGroup>
    <Page Include="UI\BatchTagDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="UI\CleanupDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="UI\CopyDimensionsDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="UI\AutoKeynoteTagDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
