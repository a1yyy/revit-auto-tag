<Window x:Class="RevitToolkit.UI.AutoKeynoteTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Keynote Tag"
        Width="520" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E2E">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#A6E3A1"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🏷  Auto Keynote Tag" FontSize="20" FontWeight="Bold"
                       Foreground="#A6E3A1" FontFamily="Segoe UI"/>
            <TextBlock Text="Automatically place keynote tags on elements in the active view."
                       Foreground="#6C7086" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Model source -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Label Content="MODEL SOURCE" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,0,4"/>
            <ComboBox x:Name="ModelSourceCombo"/>
        </StackPanel>

        <!-- Categories with preset buttons -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Grid Margin="0,0,0,6">
                <Label Content="ELEMENT CATEGORIES" FontWeight="SemiBold" Foreground="#89B4FA"
                       Padding="0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Arch"      Style="{StaticResource PresetBtn}" Click="PresetArch_Click"      Margin="0,0,4,0"/>
                    <Button Content="Landscape" Style="{StaticResource PresetBtn}" Click="PresetLandscape_Click" Margin="0,0,4,0"/>
                    <Button Content="All"       Style="{StaticResource PresetBtn}" Click="SelectAll_Click"       Margin="0,0,4,0"/>
                    <Button Content="None"      Style="{StaticResource PresetBtn}" Click="ClearAll_Click"/>
                </StackPanel>
            </Grid>
            <Border Background="#313244" CornerRadius="4" Padding="8,6">
                <ScrollViewer Height="165" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryPanel"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Keynote tag type -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <Label Content="KEYNOTE TAG TYPE" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,0,4"/>
            <ComboBox x:Name="TagTypeCombo">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding FamilyName}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding Name}" Foreground="#6C7086"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="TagTypeWarning"
                       Text="⚠  No Keynote Tag families found. Load one via Insert → Load Family."
                       Foreground="#F38BA8" FontSize="11" Margin="0,4,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Tag orientation -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <Label Content="TAG ORIENTATION" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,0,4"/>
            <ComboBox x:Name="OrientationCombo"/>
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <Label Content="OPTIONS" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,0,4"/>
            <CheckBox x:Name="LeaderCheckBox" Content="Include leader line"
                      Foreground="#CDD6F4" FontFamily="Segoe UI" FontSize="12"
                      IsChecked="False"/>
            <CheckBox x:Name="OneTagPerTypeCheckBox" Content="Tag one instance per family type"
                      Foreground="#CDD6F4" FontFamily="Segoe UI" FontSize="12"
                      IsChecked="True" Margin="0,6,0,0"
                      ToolTip="Only one element per family type is tagged. Re-running is safe — types already tagged in this view are skipped."/>
            <CheckBox x:Name="AvoidOverlapsCheckBox" Content="Avoid tag overlaps"
                      Foreground="#CDD6F4" FontFamily="Segoe UI" FontSize="12"
                      IsChecked="True" Margin="0,6,0,0"
                      ToolTip="After placing tags, nudge overlapping tags apart. Disable for very large models if speed is a concern."/>
        </StackPanel>

        <!-- Info block -->
        <Border Grid.Row="7" Background="#313244" CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="11">
                <Run FontWeight="Bold" Foreground="#FAB387">ℹ  How it works: </Run>
                <Run>Select one or more categories, or use a preset. Elements already tagged in this view are skipped automatically. Only elements with a valid Keynote parameter value will receive a tag.</Run>
            </TextBlock>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryBtn}"
                    Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="OkBtn" Content="Place Tags →" Style="{StaticResource PrimaryBtn}"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
