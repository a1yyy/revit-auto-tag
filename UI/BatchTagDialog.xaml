<Window x:Class="RevitToolkit.UI.BatchTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Auto Tag"
        Width="560" Height="730"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E2E">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#A6E3A1"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Model + tag type + orientation -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- Options -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- Categories -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- Views header + filter -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>  <!-- Threshold -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>     <!-- View list -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>  <!-- View select all/none + count -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🔄  Batch Auto Keynote Tag" FontSize="18" FontWeight="Bold"
                       Foreground="#A6E3A1" FontFamily="Segoe UI"/>
            <TextBlock Text="Tag elements across multiple views in one pass."
                       Foreground="#6C7086" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Model / Tag type / Orientation in one row -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="MODEL SOURCE" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,0,3"/>
                <ComboBox x:Name="ModelSourceCombo"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="KEYNOTE TAG TYPE" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,0,3"/>
                <ComboBox x:Name="TagTypeCombo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11">
                                <Run Text="{Binding FamilyName, Mode=OneWay}"/>
                                <Run Text=" — " Foreground="#6C7086"/>
                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="#6C7086"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="TagTypeWarning" Visibility="Collapsed"
                           Text="⚠  No Keynote Tag families found."
                           Foreground="#F38BA8" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="ORIENTATION" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,0,3"/>
                <ComboBox x:Name="OrientationCombo"/>
            </StackPanel>
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <CheckBox x:Name="LeaderCheckBox" Content="Leader line"
                      Foreground="#CDD6F4" FontFamily="Segoe UI" FontSize="11" IsChecked="False" Margin="0,0,16,0"/>
            <CheckBox x:Name="OneTagPerTypeCheckBox" Content="One per family type"
                      Foreground="#CDD6F4" FontFamily="Segoe UI" FontSize="11" IsChecked="True" Margin="0,0,16,0"/>
            <CheckBox x:Name="AvoidOverlapsCheckBox" Content="Avoid overlaps"
                      Foreground="#CDD6F4" FontFamily="Segoe UI" FontSize="11" IsChecked="True"/>
        </StackPanel>

        <!-- Categories -->
        <StackPanel Grid.Row="6">
            <Grid Margin="0,0,0,5">
                <Label Content="CATEGORIES" FontWeight="SemiBold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Arch"      Style="{StaticResource PresetBtn}" Click="PresetArch_Click"      Margin="0,0,4,0"/>
                    <Button Content="Landscape" Style="{StaticResource PresetBtn}" Click="PresetLandscape_Click" Margin="0,0,4,0"/>
                    <Button Content="All"       Style="{StaticResource PresetBtn}" Click="CatAll_Click"          Margin="0,0,4,0"/>
                    <Button Content="None"      Style="{StaticResource PresetBtn}" Click="CatNone_Click"/>
                </StackPanel>
            </Grid>
            <Border Background="#313244" CornerRadius="4" Padding="8,5">
                <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryPanel"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Views header + type filter -->
        <Grid Grid.Row="8">
            <Label Content="VIEWS TO TAG" FontWeight="SemiBold" Foreground="#89B4FA" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Label Content="Filter:" Foreground="#6C7086" Margin="0,0,4,0"/>
                <ComboBox x:Name="ViewTypeFilter" Width="120"
                          SelectionChanged="ViewTypeFilter_Changed">
                    <ComboBoxItem Content="All view types" Tag=""/>
                    <ComboBoxItem Content="Floor Plans"    Tag="FloorPlan"/>
                    <ComboBoxItem Content="Ceiling Plans"  Tag="CeilingPlan"/>
                    <ComboBoxItem Content="Sections"       Tag="Section"/>
                    <ComboBoxItem Content="Elevations"     Tag="Elevation"/>
                    <ComboBoxItem Content="Detail Views"   Tag="Detail"/>
                    <ComboBoxItem Content="Drafting Views" Tag="DraftingView"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Threshold -->
        <StackPanel Grid.Row="10" Orientation="Horizontal">
            <CheckBox x:Name="ThresholdCheckBox" Content="Skip views with fewer than"
                      Foreground="#CDD6F4" FontFamily="Segoe UI" FontSize="11"
                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ThresholdValue" Text="3" Width="36" Height="22"
                     Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                     TextAlignment="Center" FontSize="11" VerticalContentAlignment="Center"/>
            <TextBlock Text=" untagged elements" Foreground="#CDD6F4" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,0,1"/>
        </StackPanel>

        <!-- View list -->
        <Border Grid.Row="12" Background="#313244" BorderBrush="#45475A"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6">
                <StackPanel x:Name="ViewPanel"/>
            </ScrollViewer>
        </Border>

        <!-- View select all/none + count -->
        <Grid Grid.Row="14">
            <StackPanel Orientation="Horizontal">
                <Button Content="All"  Style="{StaticResource PresetBtn}" Click="ViewSelectAll_Click"  Margin="0,0,4,0"/>
                <Button Content="None" Style="{StaticResource PresetBtn}" Click="ViewSelectNone_Click"/>
            </StackPanel>
            <TextBlock x:Name="SelectionCountText" HorizontalAlignment="Right"
                       Foreground="#6C7086" FontSize="11" FontFamily="Segoe UI"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryBtn}"
                    Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="OkBtn" Content="Tag Selected Views →"
                    Style="{StaticResource PrimaryBtn}" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
